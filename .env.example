# Copy this file to `.env` in the project root and fill in your values.
# Every variable is optional unless marked REQUIRED; defaults live in src/config/settings.py.

# ── API keys ────────────────────────────────────────────────
# REQUIRED for cloud models: NVIDIA (integrate.api.nvidia.com) or OpenAI-compatible key
OPENAI_API_KEY=your_nvidia_or_openai_key
# Google Custom Search (google_search tool)
GOOGLE_SEARCH_API_KEY=
CX=
# Gemini (RAG triple extraction)
GEMINI_API_KEY=

# ── Models ──────────────────────────────────────────────────
DEFAULT_MODEL=llava-llama3:latest
CYPHER_MODEL=deepseek-r1:8b
CLASSIFIER_MODEL=llama3.1:8b
GPT_MODEL=openai/gpt-oss-120b
KIMI_MODEL=moonshotai/kimi-k2-instruct-0905

# ── Timeouts (seconds) ──────────────────────────────────────
OPENAI_TIMEOUT=60
OPENAI_CONNECT_TIMEOUT=10
MCP_TIMEOUT=30
BROWSER_USE_TIMEOUT=1300

# ── Log server socket ───────────────────────────────────────
SOCKET_HOST=localhost
SOCKET_PORT=5390

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
# separate_window | background | file
#   separate_window opens a new console (Windows) or terminal emulator (Linux/macOS)
#   use `background` or `file` on headless machines and in Docker
LOG_DISPLAY_MODE=separate_window
ENABLE_SOCKET_LOGGING=true
ENABLE_SOUND_NOTIFICATIONS=true

# ── Features ────────────────────────────────────────────────
MCP_ENABLED=true
BROWSER_USE_ENABLED=true
# BROWSER_USE_USER_PROFILE_PATH=/path/to/browser/profile
DEBUG=false

# ── Agent tuning ────────────────────────────────────────────
SKIP_THRESHOLD=70
RECURSION_LIMIT=500
SEMAPHORE_LIMIT_CLI=10
SEMAPHORE_LIMIT_API=5
SEMAPHORE_LIMIT_OPENAI=15

# ── Translation service (translate tool) ────────────────────
TRANSLATION_API_URL=http://localhost:5560/translate

# ── Neo4j (optional, RAG knowledge graph) ───────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
